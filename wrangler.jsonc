{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gem-cloudflare-manager-staging",
  "main": "apps/control/src/worker.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory":"./dist/ui","binding":"ASSETS","run_worker_first":["/api/*","/auth/*","/oauth/*","/.well-known/*","/mcp"]},
  "d1_databases": [{"binding":"DB","database_name":"gem-cloudflare-manager-staging","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "vars": {"APP_ORIGIN":"http://localhost:8787","GOOGLE_CLIENT_ID":"configure-me","CF_CLIENT_ID":"configure-me","CF_SCOPES":"configure-from-cloudflare-scope-catalog","MCP_CLIENT_ID":"chatgpt","MCP_REDIRECT_URIS":"https://chatgpt.com/connector_platform_oauth_redirect","KEY_VERSION":"v1"},
  "observability":{"enabled":true,"head_sampling_rate":1}
}
