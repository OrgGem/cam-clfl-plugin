{
  "name": "gem-cloudflare-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build apps/control --outDir ../../dist/ui --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run validate:plugin",
    "types": "wrangler types",
    "db:local": "wrangler d1 migrations apply DB --local",
    "test:e2e": "npm run build && node scripts/e2e-setup.mjs && playwright test",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "hono": "^4.11.0",
    "jose": "^6.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.10",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
